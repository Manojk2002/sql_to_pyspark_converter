# SQL → PySpark SQL AI Framework — Environment Variables
# Copy this file to .env and fill in your values.
#
# FREE OPTIONS (recommended):
#   Option 1 — Ollama (local, 100% free, no account needed)
#   Option 2 — HuggingFace (free tier, rate-limited)
#   Option 3 — Google Gemini Flash (1 million tokens/month free)
#
# Auto-detection priority: Ollama → HuggingFace → Gemini → OpenAI → Anthropic
# Set AI_PROVIDER to force a specific provider.

# AI_PROVIDER=ollama   ← uncomment to force Ollama regardless of other keys

# ════════════════════════════════════════════════════════════════════════════
#  FREE OPTION 1 — Ollama  (local, completely free, no account required)
#  Install: https://ollama.com   then run: ollama pull qwen2.5-coder:7b
#  No API key needed. Runs on your own machine. Auto-detected when running.
# ════════════════════════════════════════════════════════════════════════════
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b
# Other good free models:
# OLLAMA_MODEL=codellama        # Meta CodeLlama (3.8 GB)
# OLLAMA_MODEL=deepseek-coder   # DeepSeek Coder (3.8 GB)
# OLLAMA_MODEL=mistral          # Mistral 7B (4.1 GB)
# OLLAMA_MODEL=qwen2.5-coder:1.5b  # lightweight, only 986 MB

# ════════════════════════════════════════════════════════════════════════════
#  FREE OPTION 2 — HuggingFace Inference API  (free tier, rate-limited)
#  Get a free token at: https://huggingface.co/settings/tokens
# ════════════════════════════════════════════════════════════════════════════
# HF_TOKEN=hf_your_token_here
# HF_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct   ← default
# HF_MODEL=mistralai/Mistral-7B-Instruct-v0.3
# HF_MODEL=microsoft/Phi-3.5-mini-instruct

# ════════════════════════════════════════════════════════════════════════════
#  FREE OPTION 3 — Google Gemini Flash  (1 million tokens/month free)
#  Get a free key at: https://aistudio.google.com/app/apikey
# ════════════════════════════════════════════════════════════════════════════
# GOOGLE_API_KEY=your-google-api-key-here
# GEMINI_MODEL=gemini-1.5-flash   ← default (free)
# GEMINI_MODEL=gemini-2.0-flash   # newer, also free

# ════════════════════════════════════════════════════════════════════════════
#  PAID OPTION — OpenAI  (GPT-4.1-mini, ~$0.40/1M tokens)
# ════════════════════════════════════════════════════════════════════════════
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=https://<resource>.openai.azure.com/   ← Azure only

# ════════════════════════════════════════════════════════════════════════════
#  PAID OPTION — Anthropic Claude  (claude-3-5-haiku, ~$0.80/1M tokens)
# ════════════════════════════════════════════════════════════════════════════
# ANTHROPIC_API_KEY=your-anthropic-api-key-here
# ANTHROPIC_MODEL=claude-3-5-haiku-20241022
